# Database Configuration
DB_PATH=file:campuscash.db?cache=shared

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Environment Configuration
# Set to "development" or "production"
# In development mode, MailHog will be used automatically if SMTP_HOST is not set
ENV=development

# SMTP Configuration (for email notifications)
# 
# DEVELOPMENT MODE:
# If ENV=development (or GIN_MODE=debug) and SMTP_HOST is not set,
# the system will automatically use MailHog (localhost:1025).
# To use MailHog, run: docker-compose up -d
# Access MailHog web UI at: http://localhost:8025
#
# PRODUCTION MODE:
# Configure your SMTP server below for production
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# Cron Job Configuration
CRON_SECRET=demo-secret-123
CRON_INTERVAL_SECONDS=60
CRON_COINS_AMOUNT=100

# Server Configuration
PORT=8080
GIN_MODE=debug

# Image Configuration
MAX_IMAGE_SIZE=5242880
ALLOWED_IMAGE_TYPES=jpg,jpeg,png,gif

